{%- set home = site.homeHref(lang) -%}
{%- set onHome = (slug == "home") -%}
<header><a class="logo" href="{{ home }}"><img src="images/logo.svg" alt="Elbilnorden"></a>
<nav><div class="dd"><a href="{{ home }}#models">{{ t.nav.models }} <span class="caret">▾</span></a><div class="menu">{% for m in t.nav.menu %}<a href="{{ m.slug | url(lang) }}"><b>{{ site.models[loop.index0].name }}</b><span>{{ m.sub }}</span></a>{% endfor %}<a href="{{ home }}#models" class="all">{{ t.nav.all }}</a></div></div><a href="{{ 'camper' | url(lang) }}">{{ t.nav.camper }}</a><a href="{{ home }}#costs">{{ t.nav.costs }}</a><a href="{{ home }}#service">{{ t.nav.service }}</a><a href="{{ home }}#about">{{ t.nav.about }}</a><a class="btn btn-soft" href="{{ 'dealer' | url(lang) }}">{{ t.nav.dealer }}</a><a class="btn btn-primary" href="{% if hasContact %}#contact{% else %}{{ home }}#contact{% endif %}">{{ t.nav.cta }}</a></nav>
<select aria-label="Language" onchange="try{localStorage.setItem('ebold-lang',this.options[this.selectedIndex].text.toLowerCase())}catch(e){};location.href=this.value">{% for l in site.langs %}<option value="{{ slug | url(l) }}"{% if l == lang %} selected{% endif %}>{{ l | upper }}</option>{% endfor %}</select></header>
