---js
{
  pagination: { data: "site.langs", size: 1, alias: "lang" },
  permalink: (d) => (d.lang === "no" ? "index.html" : `${d.lang}.html`),
  layout: "base.njk",
  slug: "home",
  bodyClass: "home",
  hasContact: true,
  eleventyComputed: {
    t: (d) => d.i18n[d.lang],
    head: (d) => d.i18n[d.lang].home.head,
  },
}
---
{%- set h = t.home -%}
<section class="hero"><div><div class="eyebrow">{{ h.hero.eyebrow }}</div><h1>{{ h.hero.title }}</h1><p class="lead">{{ h.hero.lead }}</p>
<div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:28px"><a class="btn btn-primary" href="#models">{{ h.hero.btns[0] }}</a><a class="btn btn-ghost" href="#contact">{{ h.hero.btns[1] }}</a></div><div class="kpis">{% for k in h.hero.kpis %}<div><b>{{ k[0] }}</b><span>{{ k[1] }}</span></div>{% endfor %}</div></div>
<div class="media"><img src="images/ebold-outdoor.webp" alt="Hudson eBOLD" fetchpriority="high"><button type="button" class="play" data-video="{{ site.video.home }}" data-title="eBOLD"><i aria-hidden="true">▶</i>{{ h.hero.video }}</button><a class="hero-badge" href="{{ 'ebold' | url(lang) }}"><span><b>eBOLD · 12&nbsp;m³</b>309–415&nbsp;km WLTP</span><span class="go" aria-hidden="true">→</span></a></div></section>

<section class="wrap" id="models"><div class="eyebrow">{{ h.models.eyebrow }}</div><h2 style="font-size:clamp(30px,3.4vw,46px)">{{ h.models.title }}</h2><p class="lead">{{ h.models.lead }}</p><div class="models">{% for mm in site.models %}{% set m = mm.slug %}{% set mname = mm.name %}{% set c = h.cards[m] %}{% set alt = "" %}{% include "card.njk" %}{% endfor %}</div></section>
<section class="wrap uses-sec" style="background:#fff"><div class="eyebrow">{{ h.uses.eyebrow }}</div><h2 style="font-size:clamp(30px,3.4vw,46px)">{{ h.uses.title }}</h2><div class="uses">{% for u in h.uses.items %}<div class="use"><h3>{{ u.title }}</h3><p>{{ u.text }}</p><span class="go">{% for k in u.links %}{% if not loop.first %} · {% endif %}<a href="{{ k[0] | url(lang) }}">{{ k[1] }}</a>{% endfor %}</span></div>{% endfor %}</div></section>
<section class="wrap band"><div class="two"><div><div class="eyebrow">{{ h.camper.eyebrow }}</div><h2 style="font-size:clamp(30px,3.4vw,46px)">{{ h.camper.title }}</h2><p class="lead">{{ h.camper.lead }}</p>{% if lang == "no" %}<div class="camper-prices"><div><small>BASIC</small><b>{{ site.camperPrices.basic | nb }}</b><span>inkl. mva</span></div><div><small>PRO</small><b>{{ site.camperPrices.pro | nb }}</b><span>inkl. mva · 400&nbsp;W solcelle</span></div></div>{% endif %}<a class="btn btn-ghost" href="{{ 'camper' | url(lang) }}" style="margin-top:24px">{{ h.camper.btn }}</a></div><div class="mosaic"><img src="images/camper/sofa.webp" alt="{{ h.camper.alts[0] }}" loading="lazy"><img src="images/camper/kitchen.webp" alt="{{ h.camper.alts[1] }}" loading="lazy"><img src="images/camper/bed.webp" alt="{{ h.camper.alts[2] }}" loading="lazy"></div></div></section>
{%- set c = h.costs %}
<section class="wrap" id="costs"><div class="eyebrow">{{ c.eyebrow }}</div><h2 style="font-size:clamp(30px,3.4vw,46px)">{{ c.title }}</h2><p class="lead">{{ c.lead }}</p>
<div class="calc"><div><label>{{ c.model }}</label><select id="cm">{% for mm in site.models %}<option value="{{ mm.slug }}"{% if mm.slug == "ebold" %} selected{% endif %}>{{ c.options[mm.slug] }}</option>{% endfor %}</select>
<label>{{ c.km[0] }}<span id="kmv">120</span>{{ c.km[1] }}</label><input type="range" id="km" min="20" max="400" step="10" value="120">
<label>{{ c.days[0] }}<span id="dv">250</span>{{ c.days[1] }}</label><input type="range" id="d" min="100" max="365" step="5" value="250">
<label>{{ c.el }}</label><input type="number" id="el" step="{{ c.elStep }}" value="{{ c.elPrice }}"><label>{{ c.fuel }}</label><input type="number" id="fu" step="{{ c.fuelStep }}" value="{{ c.fuelPrice }}">
<p class="note">{{ c.note }}</p></div>
<div class="result"><div style="font-size:13px;opacity:.7">{{ c.saving }}</div><div class="big" id="sav"></div><div style="font-size:14px;opacity:.7">{{ c.perYear }}</div>
<dl><dt>{{ c.rows[0] }}</dt><dd id="yr"></dd><dt>{{ c.rows[1] }}</dt><dd id="ce"></dd><dt>{{ c.rows[2] }}</dt><dd id="cd"></dd><dt>{{ c.rows[3] }}</dt><dd id="pk"></dd></dl></div></div></section>
<script>(function(){var LANG='{{ lang }}',LOC='{{ c.loc }}',CUR='{{ c.cur }}';var C={"evoxx": [12, 6], "ebear": [22, 8], "ebold": [32, 9.5], "ehaustus": [55, 18]};var $=function(i){return document.getElementById(i)};function f(n,d){var s=n.toLocaleString(LOC,{minimumFractionDigits:d||0,maximumFractionDigits:d||0});return LANG==='en'?'€'+s:s+' '+CUR}
function u(){var c=C[$('cm').value],km=+$('km').value,d=+$('d').value,el=+$('el').value,fu=+$('fu').value,y=km*d;$('kmv').textContent=km;$('dv').textContent=d;var e=y*c[0]/100*el,z=y*c[1]/100*fu;$('sav').textContent=f(z-e);$('yr').textContent=y.toLocaleString(LOC)+' km';$('ce').textContent=f(e);$('cd').textContent=f(z);$('pk').textContent=f(e/y,2)+' / km'}
['cm','km','d','el','fu'].forEach(function(i){$(i).addEventListener('input',u)});u()})();</script><section class="wrap" id="service"><div class="eyebrow">{{ h.service.eyebrow }}</div><h2 style="font-size:clamp(30px,3.4vw,46px)">{{ h.service.title }}</h2><p class="lead">{{ h.service.lead }}</p><div class="grid3">{% for s in h.service.items %}<div><h3>{{ s[0] }}</h3><p>{{ s[1] }}</p></div>{% endfor %}</div></section>
<section class="wrap" id="about"><div class="two"><div><div class="eyebrow">{{ h.about.eyebrow }}</div><h2 style="font-size:clamp(30px,3.4vw,46px)">{{ h.about.title }}</h2><p class="lead">{{ h.about.lead }}</p><p style="color:var(--ink2)">{{ h.about.text }}</p></div><img src="images/about-lineup.webp" alt="{{ h.about.alt }}" loading="lazy" style="border-radius:8px"></div></section>{% set selected = "" %}{% include "contact.njk" %}
<div class="vbox" id="vb" role="dialog" aria-modal="true" aria-label="Video"><button type="button" aria-label="{{ t.camper.close }}">×</button><div class="fr"></div></div><script>(function(){var b=document.getElementById('vb'),f=b.querySelector('.fr');function x(){b.classList.remove('on');f.innerHTML=''}document.querySelectorAll('[data-video]').forEach(function(p){p.addEventListener('click',function(){f.innerHTML='<iframe src="https://www.youtube-nocookie.com/embed/'+p.dataset.video+'?rel=0&autoplay=1&playsinline=1" title="'+p.dataset.title+'" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>';b.classList.add('on');b.querySelector('button').focus()})});b.addEventListener('click',function(e){if(e.target!==f)x()});document.addEventListener('keydown',function(e){if(e.key==='Escape')x()})})();</script>
